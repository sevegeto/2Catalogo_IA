# ============================================================
# CatalogAI - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file to the repository.
# All credentials must use environment variables.
# ============================================================

# ---- Active backend: Supabase ----
# Optional for local demo. Set both values to enable real database operations.
# Use the public anon key, NEVER the service_role key.
# With these set, the app requires sign-in (Supabase Auth) except in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Variables below describe planned integrations, not implemented backend services.
# ---- Database ----
# MySQL connection string for Prisma (SiteGround)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# ---- Authentication ----
# Sessions are handled by Supabase Auth; no extra secret is needed in the app.
# Base URL of the application
APP_URL=http://localhost:3000

# ---- Worker (Fedora / Ollama) ----
# API key for the local worker to authenticate against the backend
WORKER_API_SECRET=
# Default Ollama model for AI jobs
OLLAMA_DEFAULT_MODEL=

# ---- Google Workspace ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Drive folder ID for image storage
GOOGLE_DRIVE_FOLDER_ID=

# ---- MercadoLibre ----
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=

# ---- Amazon ----
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=

# ---- Shopify ----
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
